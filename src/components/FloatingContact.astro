---
import { siteConfig } from '../data/content';
---

<!-- Botón Flotante Permanente: Azul Corporativo con Borde Dorado Animado y WhatsApp "HABLEMOS" -->
<aside class="floating-contact-wrap" aria-label="Contacto directo por WhatsApp">
  <a 
    href={siteConfig.whatsappUrl} 
    target="_blank" 
    rel="noopener noreferrer" 
    class="floating-contact-btn"
    aria-label="Hablemos por WhatsApp con Angela Ramírez"
  >
    <span class="floating-border-anim" aria-hidden="true"></span>
    <span class="floating-shine" aria-hidden="true"></span>
    <span class="floating-pulse-ring" aria-hidden="true"></span>
    <div class="floating-icon-wrap" aria-hidden="true">
      <svg class="floating-wa-icon" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.203c.043.072.043.419-.101.824z"/>
      </svg>
      <span class="floating-online-dot"></span>
    </div>
    <span class="floating-label">HABLEMOS</span>
  </a>
</aside>

<style>
  .floating-contact-wrap {
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 9999;
    pointer-events: auto;
  }

  .floating-contact-btn {
    display: flex;
    align-items: center;
    gap: 0.95rem;
    padding: 0.55rem 1.6rem 0.55rem 0.65rem;
    border-radius: 999px;
    text-decoration: none;
    position: relative;
    background: linear-gradient(135deg, #163A5F 0%, #0D263F 65%, #081B2E 100%);
    box-shadow: 
      0 10px 30px rgba(13, 38, 63, 0.45),
      0 0 20px rgba(184, 155, 94, 0.35);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), 
                box-shadow 0.35s ease, 
                filter 0.35s ease;
    overflow: hidden;
  }

  .floating-contact-btn:hover {
    transform: translateY(-4px) scale(1.04);
    box-shadow: 
      0 16px 42px rgba(13, 38, 63, 0.6),
      0 0 32px rgba(223, 202, 141, 0.7);
    filter: brightness(1.06);
  }

  /* Borde en línea dorada animada fluida continua */
  .floating-border-anim {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    padding: 2px;
    background: linear-gradient(90deg, #9E7D3B 0%, #DFCA8D 25%, #FFF9E0 50%, #DFCA8D 75%, #9E7D3B 100%);
    background-size: 250% 100%;
    animation: goldBorderFlow 3s linear infinite;
    -webkit-mask: 
      linear-gradient(#fff 0 0) content-box, 
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  @keyframes goldBorderFlow {
    0% { background-position: 0% 50%; }
    100% { background-position: 250% 50%; }
  }

  /* Barrido de brillo periódico */
  .floating-shine {
    position: absolute;
    top: 0;
    left: -120%;
    width: 60%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(223, 202, 141, 0.35), transparent);
    transform: skewX(-24deg);
    animation: floatingShineSweep 4.5s infinite ease-in-out;
    pointer-events: none;
  }

  @keyframes floatingShineSweep {
    0%, 65% { left: -120%; }
    80%, 100% { left: 160%; }
  }

  /* Anillo de pulso áureo exterior */
  .floating-pulse-ring {
    position: absolute;
    inset: -4px;
    border-radius: 999px;
    border: 2px solid rgba(223, 202, 141, 0.75);
    opacity: 0;
    animation: floatingPulse 2.6s cubic-bezier(0.22, 1, 0.36, 1) infinite;
    pointer-events: none;
  }

  @keyframes floatingPulse {
    0% { transform: scale(0.96); opacity: 0.9; }
    60%, 100% { transform: scale(1.18, 1.35); opacity: 0; }
  }

  /* Contenedor del icono */
  .floating-icon-wrap {
    position: relative;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 1.5px solid rgba(223, 202, 141, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25), 0 0 10px rgba(223, 202, 141, 0.3);
    transition: transform 0.3s ease;
  }

  /* Símbolo de WhatsApp 2x (44px) animado con vibración / campanilleo periódico */
  .floating-wa-icon {
    width: 44px;
    height: 44px;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
    animation: waChimeAnimation 3.6s ease-in-out infinite;
    transform-origin: center center;
  }

  @keyframes waChimeAnimation {
    0%, 100% {
      transform: scale(1) rotate(0deg);
    }
    8%, 16% {
      transform: scale(1.14) rotate(-10deg);
    }
    12%, 20% {
      transform: scale(1.14) rotate(10deg);
    }
    24% {
      transform: scale(1.08) rotate(-4deg);
    }
    28% {
      transform: scale(1) rotate(0deg);
    }
  }

  .floating-contact-btn:hover .floating-wa-icon {
    animation: waHoverWiggle 0.6s ease-in-out infinite alternate;
  }

  @keyframes waHoverWiggle {
    0% { transform: scale(1.15) rotate(-8deg); }
    100% { transform: scale(1.15) rotate(8deg); }
  }

  .floating-online-dot {
    position: absolute;
    bottom: 2px;
    right: 2px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #25D366;
    border: 2px solid #FFFFFF;
    box-shadow: 0 0 8px #25D366;
    animation: dotBlink 1.8s ease-in-out infinite;
  }

  @keyframes dotBlink {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.85); }
  }

  /* Texto interno todo en mayúscula y en color dorado */
  .floating-label {
    font-family: var(--font-sans, 'Montserrat', sans-serif);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #DFCA8D;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6), 0 0 14px rgba(223, 202, 141, 0.45);
    white-space: nowrap;
    transition: color 0.3s ease, text-shadow 0.3s ease;
  }

  .floating-contact-btn:hover .floating-label {
    color: #FFF6D6;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.7), 0 0 20px rgba(255, 246, 214, 0.85);
  }

  @media (max-width: 640px) {
    .floating-contact-wrap {
      bottom: 18px;
      right: 18px;
    }

    .floating-contact-btn {
      padding: 0.45rem 1.3rem 0.45rem 0.55rem;
      gap: 0.75rem;
    }

    .floating-icon-wrap {
      width: 48px;
      height: 48px;
    }

    .floating-wa-icon {
      width: 40px;
      height: 40px;
    }

    .floating-label {
      font-size: 1.02rem;
      letter-spacing: 0.07em;
    }
  }
</style>
