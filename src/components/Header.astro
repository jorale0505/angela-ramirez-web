---
import BrandLogo from './BrandLogo.astro';
import { siteConfig } from '../data/content';
---

<header id="main-header" class="site-header">
  <div class="container header-container">
    <a href="#hero" class="logo-link" aria-label="Ir al inicio de Angela Ramírez">
      <BrandLogo variant="horizontal" theme="dark" size="sm" />
    </a>

    <!-- Navegación de Escritorio -->
    <nav class="desktop-nav" aria-label="Navegación principal">
      <a href="#sobre-mi" class="nav-link">Sobre Mí</a>
      <a href="#servicios" class="nav-link">Servicios</a>
      <a href="#recursos-gratis" class="nav-link">Recursos Gratis</a>
    </nav>

    <!-- Controles de Cabecera -->
    <div class="header-actions">
      <!-- Botón Menú Móvil -->
      <button id="mobile-menu-btn" class="mobile-toggle" aria-label="Abrir menú" aria-expanded="false">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>

  <!-- Menú Desplegable Móvil -->
  <div id="mobile-nav-menu" class="mobile-nav" aria-hidden="true">
    <nav class="mobile-nav-links">
      <a href="#sobre-mi" class="mobile-link">Sobre Mí</a>
      <a href="#servicios" class="mobile-link">Servicios</a>
      <a href="#recursos-gratis" class="mobile-link">Recursos Gratis</a>
      <div class="mobile-cta-box">
        <a href={siteConfig.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-gold btn-full">
          Contacto Directo por WhatsApp
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(22, 58, 95, 0.08);
    transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .site-header.scrolled {
    background: rgba(255, 255, 255, 0.98);
    border-bottom-color: rgba(184, 155, 94, 0.3);
    box-shadow: 0 8px 30px rgba(22, 58, 95, 0.07);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 78px;
  }

  .logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .desktop-nav {
    display: none;
    align-items: center;
    gap: 1.8rem;
  }

  @media (min-width: 992px) {
    .desktop-nav {
      display: flex;
    }
  }

  .nav-link {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-primary-dark);
    position: relative;
    padding: 0.5rem 0;
    transition: color 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 2px;
    background-color: var(--color-gold-champagne);
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link:hover {
    color: var(--color-gold-champagne);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .calc-badge {
    background: linear-gradient(135deg, #B89B5E, #9C7F43);
    color: #FFFFFF;
    font-size: 0.62rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .btn-sm {
    padding: 0.65rem 1.25rem;
    font-size: 0.8rem;
    display: none;
  }

  @media (min-width: 640px) {
    .btn-sm {
      display: inline-flex;
    }
  }

  /* Botón Hamburguesa Móvil */
  .mobile-toggle {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 28px;
    height: 20px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  @media (min-width: 992px) {
    .mobile-toggle {
      display: none;
    }
  }

  .mobile-toggle .bar {
    width: 100%;
    height: 2px;
    background-color: var(--color-primary-dark);
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .mobile-toggle.active .bar:nth-child(1) {
    transform: translateY(9px) rotate(45deg);
  }

  .mobile-toggle.active .bar:nth-child(2) {
    opacity: 0;
  }

  .mobile-toggle.active .bar:nth-child(3) {
    transform: translateY(-9px) rotate(-45deg);
  }

  /* Menú Móvil */
  .mobile-nav {
    display: none;
    position: absolute;
    top: 78px;
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-gold);
    box-shadow: 0 16px 32px rgba(22, 58, 95, 0.12);
    padding: 1.5rem 2rem 2.5rem;
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .mobile-nav.open {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .mobile-link {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-primary-dark);
    padding: 0.4rem 0;
    border-bottom: 1px solid rgba(22, 58, 95, 0.06);
  }

  .mobile-cta-box {
    margin-top: 1rem;
  }

  .btn-full {
    width: 100%;
  }
</style>

<script>
  function setupHeader() {
    const header = document.getElementById('main-header');
    const toggleBtn = document.getElementById('mobile-menu-btn');
    const mobileNav = document.getElementById('mobile-nav-menu');

    // Efecto de scroll en header
    window.addEventListener('scroll', () => {
      if (window.scrollY > 20) {
        header?.classList.add('scrolled');
      } else {
        header?.classList.remove('scrolled');
      }
    }, { passive: true });

    // Alternar menú móvil
    if (toggleBtn && mobileNav) {
      toggleBtn.addEventListener('click', () => {
        const isOpen = mobileNav.classList.toggle('open');
        toggleBtn.classList.toggle('active', isOpen);
        toggleBtn.setAttribute('aria-expanded', String(isOpen));
        mobileNav.setAttribute('aria-hidden', String(!isOpen));
      });

      // Cerrar menú al dar click en un enlace
      mobileNav.querySelectorAll('.mobile-link').forEach(link => {
        link.addEventListener('click', () => {
          mobileNav.classList.remove('open');
          toggleBtn.classList.remove('active');
          toggleBtn.setAttribute('aria-expanded', 'false');
          mobileNav.setAttribute('aria-hidden', 'true');
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeader);
  } else {
    setupHeader();
  }
</script>
