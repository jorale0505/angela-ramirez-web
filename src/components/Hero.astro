---
import { siteConfig, trustHighlights, heroRotatingServices } from '../data/content';
---

<section id="hero" class="hero-section">
  <!-- Fondo con luces ambientales doradas y azules -->
  <div class="hero-bg-lights" aria-hidden="true">
    <div class="ambient-glow glow-center"></div>
    <div class="ambient-glow glow-gold"></div>
    <div class="hairline-grid"></div>
  </div>

  <div class="hero-container-fluid">
    <!-- 1. Isotipo 3D Oficial Centrado -->
    <div class="hero-logo-center fade-up">
      <div class="logo-3d-halo">
        <img 
          src={`${import.meta.env.BASE_URL}logo-ar-3d.png`} 
          alt="Logotipo Oficial 3D de Angela Ramírez · Contadora Pública" 
          width="135" 
          height="92" 
          class="hero-logo-img"
          loading="eager"
        />
      </div>
    </div>

    <!-- 2. Titular Tipográfico Oficial (Fiel a la marca) -->
    <div class="hero-brand-lockup fade-up">
      <!-- Nombre en Gran Formato Serif -->
      <h1 class="brand-hero-name">ANGELA RAMÍREZ</h1>

      <!-- Subtítulo con líneas doradas simétricas que enmarcan exactamente el ancho del nombre -->
      <div class="brand-sub-row">
        <span class="decor-line"></span>
        <span class="brand-sub-text">CONTADORA PÚBLICA</span>
        <span class="decor-line"></span>
      </div>

      <!-- Slogan Oficial Centrado -->
      <p class="brand-slogan-text">TU INFORMACIÓN, EN BUENAS MANOS</p>
    </div>

    <!-- 3. MÓDULO DINÁMICO: Títulos de Servicios con Efecto Máquina de Escribir -->
    <div class="hero-typewriter-container fade-up">
      <h2 class="typewriter-headline" aria-label="Servicios Principales">
        <span id="hero-typewriter-text" class="typewriter-text">{heroRotatingServices[0].title}</span><span class="typewriter-cursor" aria-hidden="true">|</span>
      </h2>
    </div>

    <!-- 4. Llamado a la Acción Exclusivo de WhatsApp (3 palabras) -->
    <div class="hero-actions-centered fade-up">
      <a 
        href={siteConfig.whatsappUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn-gold-glow"
        aria-label="Hablemos por WhatsApp con Angela Ramírez"
      >
        <span class="btn-shine-sweep" aria-hidden="true"></span>
        <svg class="wa-icon" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.203c.043.072.043.419-.101.824z"/>
        </svg>
        <span class="btn-cta-text">Hablemos Por WhatsApp</span>
      </a>
    </div>

    <!-- 5. Barra de Métricas y Credibilidad -->
    <div class="hero-metrics-centered fade-up">
      <div class="metrics-grid-centered">
        {trustHighlights.map((item) => (
          <div class="metric-item-centered">
            <div class="metric-val-num">{item.metric}</div>
            <div class="metric-val-title">{item.label}</div>
            <div class="metric-val-sub">{item.description}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    z-index: 1;
    width: 100%;
    min-height: calc(100vh - 78px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding-top: clamp(100px, 11vh, 140px);
    padding-bottom: clamp(50px, 7vh, 85px);
    background-color: transparent;
    overflow: hidden;
    text-align: center;
    box-sizing: border-box;
  }

  /* Fondos ambientales panorámicos sutiles */
  .hero-bg-lights {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .ambient-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.35;
  }

  .glow-center {
    top: 5%;
    left: 50%;
    transform: translateX(-50%);
    width: clamp(500px, 65vw, 1100px);
    height: clamp(350px, 45vh, 650px);
    background: radial-gradient(circle, rgba(184, 155, 94, 0.16) 0%, rgba(22, 58, 95, 0.04) 60%, transparent 80%);
  }

  .glow-gold {
    bottom: -10%;
    right: 5%;
    width: clamp(350px, 40vw, 750px);
    height: clamp(350px, 40vw, 750px);
    background: radial-gradient(circle, rgba(184, 155, 94, 0.12) 0%, transparent 70%);
  }

  .hairline-grid {
    position: absolute;
    inset: 0;
    background-size: 60px 60px;
    background-image: 
      linear-gradient(to right, rgba(22, 58, 95, 0.025) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(22, 58, 95, 0.025) 1px, transparent 1px);
  }

  /* Contenedor Full-Width Fluido */
  .hero-container-fluid {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 100%;
    padding-left: clamp(1.25rem, 4vw, 4.5rem);
    padding-right: clamp(1.25rem, 4vw, 4.5rem);
    margin: 0 auto;
    box-sizing: border-box;
  }

  /* 1. Logo 3D Centrado */
  .hero-logo-center {
    margin-bottom: clamp(0.75rem, 1.8vh, 1.25rem);
  }

  .logo-3d-halo {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .logo-3d-halo:hover {
    transform: translateY(-3px) scale(1.04);
  }

  .logo-3d-halo::after {
    content: '';
    position: absolute;
    inset: 5px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(184, 155, 94, 0.28) 0%, transparent 70%);
    filter: blur(16px);
    z-index: -1;
  }

  .hero-logo-img {
    height: auto;
    width: clamp(110px, 11vw, 155px);
    object-fit: contain;
    filter: drop-shadow(0 8px 22px rgba(22, 58, 95, 0.22)) drop-shadow(0 2px 6px rgba(184, 155, 94, 0.3));
  }

  /* 2. Brand Lockup Oficial Centrado & Responsive */
  .hero-brand-lockup {
    display: inline-flex;
    flex-direction: column;
    align-items: stretch;
    text-align: center;
    width: fit-content;
    max-width: 100%;
    margin: 0.4rem auto clamp(1.2rem, 2.8vh, 2rem);
    padding: 0 0.5rem;
    box-sizing: border-box;
  }

  .brand-hero-name {
    font-family: var(--font-serif, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(2rem, 5.5vw, 5.2rem);
    font-weight: 700;
    letter-spacing: clamp(0.14em, 1.6vw, 0.24em);
    margin-right: -0.16em; /* Compensa la última letra */
    line-height: 1.08;
    color: var(--color-primary-dark);
    text-transform: uppercase;
    text-shadow: 0 2px 10px rgba(22, 58, 95, 0.06);
    text-align: center;
    white-space: nowrap;
    margin-top: 0.3rem;
    margin-bottom: 0.2rem;
  }

  @media (max-width: 520px) {
    .brand-hero-name {
      font-size: clamp(1.75rem, 8.5vw, 2.5rem);
      letter-spacing: 0.12em;
      margin-right: -0.12em;
    }
  }

  .brand-sub-row {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: clamp(0.6rem, 2vw, 1.4rem);
    margin: 0.35rem 0 0.45rem;
  }

  .decor-line {
    flex: 1;
    height: 1px;
    background-color: var(--color-gold-champagne);
    opacity: 0.85;
  }

  .brand-sub-text {
    font-family: var(--font-sans);
    font-size: clamp(0.68rem, 1.4vw, 0.96rem);
    font-weight: 700;
    letter-spacing: clamp(0.18em, 1.2vw, 0.34em);
    margin-right: -0.22em;
    color: var(--color-gold-champagne);
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .brand-slogan-text {
    font-family: var(--font-sans);
    font-size: clamp(0.65rem, 1.1vw, 0.84rem);
    font-weight: 600;
    letter-spacing: clamp(0.15em, 1vw, 0.3em);
    margin-right: -0.18em;
    color: var(--color-primary-muted);
    text-transform: uppercase;
    text-align: center;
    margin-top: 0.25rem;
  }

  /* 3. Módulo Dinámico Typewriter Full-Width */
  .hero-typewriter-container {
    width: 100%;
    max-width: 1200px;
    margin: 1.2rem auto clamp(1.6rem, 3.5vh, 2.6rem);
    min-height: clamp(65px, 8vw, 90px);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 clamp(1rem, 3vw, 2.5rem);
    box-sizing: border-box;
  }

  .typewriter-headline {
    font-family: var(--font-serif, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(1.45rem, 3.4vw, 2.85rem);
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: -0.01em;
    color: var(--color-primary-dark);
    margin: 0;
    display: inline;
    text-align: center;
  }

  .typewriter-text {
    color: var(--color-primary-dark);
    transition: color 0.2s ease;
  }

  .typewriter-cursor {
    display: inline-block;
    color: var(--color-gold-champagne);
    font-weight: 300;
    font-family: monospace, var(--font-sans);
    margin-left: 3px;
    animation: typewriter-cursor-blink 0.6s infinite ease-in-out;
  }

  @keyframes typewriter-cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* 4. Botón WhatsApp Exclusivo con Borde Dorado y Animación de Brillo */
  .hero-actions-centered {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin: 0.5rem auto 0;
  }

  .btn-gold-glow {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    padding: clamp(0.95rem, 1.8vh, 1.15rem) clamp(1.8rem, 3vw, 2.7rem);
    font-family: var(--font-sans);
    font-size: clamp(0.92rem, 1.15vw, 1.05rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary-dark);
    text-decoration: none;
    background: transparent;
    border-radius: 50px;
    cursor: pointer;
    overflow: hidden;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, color 0.3s ease;
    z-index: 1;
    /* Borde base dorado luminoso */
    border: 2px solid #B89B5E;
    box-shadow: 0 0 18px rgba(184, 155, 94, 0.28), inset 0 0 10px rgba(184, 155, 94, 0.08);
    animation: gold-border-pulse 3s infinite ease-in-out;
  }

  /* Haz de luz de brillo que viaja por todo el borde */
  .btn-gold-glow::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      transparent 70deg,
      rgba(255, 235, 175, 0.95) 110deg,
      #DFCA8D 130deg,
      #B89B5E 150deg,
      transparent 190deg,
      transparent 360deg
    );
    animation: rotate-border-beam 3.5s linear infinite;
    z-index: -2;
    opacity: 0.85;
  }

  /* Fondo transparente con máscara interior que mantiene el blanco puro */
  .btn-gold-glow::after {
    content: '';
    position: absolute;
    inset: 2px;
    background: #FFFFFF;
    border-radius: 48px;
    z-index: -1;
    transition: background 0.3s ease;
  }

  /* Destello de brillo transversal periódico */
  .btn-shine-sweep {
    position: absolute;
    top: 0;
    left: -120%;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.4),
      rgba(223, 202, 141, 0.85),
      rgba(255, 255, 255, 0.95),
      rgba(223, 202, 141, 0.85),
      transparent
    );
    transform: skewX(-25deg);
    animation: shine-sweep-anim 4.2s infinite cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
    z-index: 2;
  }

  @keyframes rotate-border-beam {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @keyframes gold-border-pulse {
    0%, 100% {
      box-shadow: 0 0 16px rgba(184, 155, 94, 0.25), 0 4px 15px rgba(22, 58, 95, 0.05);
      border-color: #B89B5E;
    }
    50% {
      box-shadow: 0 0 30px rgba(184, 155, 94, 0.55), 0 0 45px rgba(223, 202, 141, 0.35), 0 6px 20px rgba(22, 58, 95, 0.08);
      border-color: #DFCA8D;
    }
  }

  @keyframes shine-sweep-anim {
    0%, 65% { left: -120%; }
    100% { left: 220%; }
  }

  .btn-gold-glow:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 0 38px rgba(184, 155, 94, 0.75), 0 8px 25px rgba(22, 58, 95, 0.15);
    color: #163A5F;
  }

  .btn-gold-glow:hover::after {
    background: rgba(255, 255, 255, 0.92);
  }

  .btn-gold-glow .wa-icon {
    width: 24px;
    height: 24px;
    filter: drop-shadow(0 2px 6px rgba(37, 211, 102, 0.35));
    transition: transform 0.3s ease;
    z-index: 3;
  }

  .btn-gold-glow:hover .wa-icon {
    transform: scale(1.12) rotate(6deg);
  }

  .btn-cta-text {
    position: relative;
    z-index: 3;
  }

  /* 5. Métricas Centradas Full-Width & Responsive */
  .hero-metrics-centered {
    width: 100%;
    max-width: 1360px;
    margin-top: clamp(2.5rem, 6vh, 4.2rem);
    box-sizing: border-box;
  }

  .metrics-grid-centered {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1.4rem;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 14px;
    border: 1px solid rgba(22, 58, 95, 0.08);
    padding: clamp(1.8rem, 3vh, 2.5rem) clamp(1.2rem, 3vw, 2.8rem);
    box-shadow: 0 12px 35px rgba(22, 58, 95, 0.04);
  }

  @media (max-width: 480px) {
    .metrics-grid-centered {
      grid-template-columns: 1fr;
      gap: 1.8rem;
      padding: 1.8rem 1.2rem;
    }
  }

  @media (min-width: 680px) and (max-width: 1023px) {
    .metrics-grid-centered {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.2rem 1.8rem;
      padding: 2.2rem 2rem;
    }
  }

  @media (min-width: 1024px) {
    .metrics-grid-centered {
      grid-template-columns: repeat(5, 1fr);
      gap: clamp(1.5rem, 2.6vw, 3rem);
      padding: 2.5rem clamp(1.6rem, 3vw, 3.5rem);
    }

    .metric-item-centered:not(:last-child) {
      border-right: 1px solid rgba(22, 58, 95, 0.08);
      padding-right: clamp(1.2rem, 2vw, 2.4rem);
    }
  }

  .metric-item-centered {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.45rem;
  }

  /* Tipografía ejecutiva para números reducida al 75% para máxima elegancia y legibilidad */
  .metric-val-num {
    font-family: 'Plus Jakarta Sans', var(--font-sans), sans-serif;
    font-size: clamp(1.25rem, 1.55vw, 1.75rem);
    font-weight: 800;
    color: var(--color-primary-dark);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-variant-numeric: lining-nums tabular-nums;
    font-feature-settings: "lnum" 1, "tnum" 1;
    text-align: center;
    white-space: nowrap;
  }

  .metric-val-title {
    font-family: var(--font-sans);
    font-size: clamp(0.72rem, 0.85vw, 0.82rem);
    font-weight: 700;
    color: var(--color-gold-champagne);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    line-height: 1.25;
    text-align: center;
  }

  .metric-val-sub {
    font-family: var(--font-sans);
    font-size: clamp(0.74rem, 0.8vw, 0.82rem);
    color: #637587;
    line-height: 1.4;
    text-align: center;
    margin: 0;
  }
</style>

<script define:vars={{ heroRotatingServices }}>
  function initHeroTypewriter() {
    const textEl = document.getElementById('hero-typewriter-text');
    if (!textEl) return;

    // Títulos oficiales de los servicios
    const titles = heroRotatingServices.map(s => s.title);
    if (!titles.length) return;

    // Accesibilidad: respetar reducción de movimiento
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      let staticIndex = 0;
      setInterval(() => {
        staticIndex = (staticIndex + 1) % titles.length;
        textEl.textContent = titles[staticIndex];
      }, 4000);
      return;
    }

    let titleIndex = 0;
    let charIndex = titles[0].length; // Inicia con el primer título ya renderizado
    let isDeleting = true;
    let timeoutId = null;

    const TYPING_SPEED = 36;      // ms por caracter al escribir (1.5x más rápido)
    const DELETING_SPEED = 18;    // ms por caracter al borrar (1.5x más rápido)
    const PAUSE_TYPED = 1600;     // Pausa de lectura cuando está escrito completo
    const PAUSE_DELETED = 300;    // Pausa breve cuando se borra

    function tick() {
      const currentTitle = titles[titleIndex];

      if (isDeleting) {
        // Borrando caracteres
        charIndex--;
        textEl.textContent = currentTitle.substring(0, charIndex);

        if (charIndex <= 0) {
          isDeleting = false;
          titleIndex = (titleIndex + 1) % titles.length;
          timeoutId = setTimeout(tick, PAUSE_DELETED);
          return;
        }
        timeoutId = setTimeout(tick, DELETING_SPEED);
      } else {
        // Escribiendo caracteres
        charIndex++;
        textEl.textContent = currentTitle.substring(0, charIndex);

        if (charIndex >= currentTitle.length) {
          isDeleting = true;
          timeoutId = setTimeout(tick, PAUSE_TYPED);
          return;
        }
        // Variación sutil en la cadencia de tipeo para naturalidad
        const jitter = Math.random() * 12 - 6;
        timeoutId = setTimeout(tick, Math.max(16, TYPING_SPEED + jitter));
      }
    }

    // Iniciar el ciclo tras una pausa inicial de lectura del primer título
    timeoutId = setTimeout(tick, PAUSE_TYPED);

    // Pausar o reanudar cuando la pestaña cambia de visibilidad
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        if (timeoutId) clearTimeout(timeoutId);
      } else {
        timeoutId = setTimeout(tick, 600);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroTypewriter);
  } else {
    initHeroTypewriter();
  }
</script>
