---
import { faqs } from '../data/content';
---

<section id="faq" class="faq-section">
  <div class="container">
    <div class="section-header fade-up text-center">
      <span class="badge badge-gold">RESOLUCIÓN DE DUDAS FRECUENTES</span>
      <h2 class="section-title">
        Preguntas Clave sobre Normativa, <br />
        <span class="gold-text">Fiscalización y Peritajes</span>
      </h2>
      <div class="gold-divider-center"></div>
      <p class="section-subtitle">
        Criterios normativos indispensables para gerentes, directores financieros y líderes de comités de auditoría en Colombia.
      </p>
    </div>

    <div class="faq-accordion-wrap fade-up">
      {faqs.map((faq, index) => (
        <details class="faq-item" open={index === 0}>
          <summary class="faq-summary">
            <span class="faq-cat-badge">{faq.category}</span>
            <span class="faq-question-text">{faq.question}</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq-answer-content">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-section {
    padding: 90px 0;
    background: transparent;
    position: relative;
    z-index: 1;
  }

  .text-center {
    text-align: center;
  }

  .section-header {
    max-width: 800px;
    margin: 0 auto 3.5rem;
  }

  .section-title {
    font-size: 2.5rem;
    color: var(--color-primary-dark);
    margin-top: 0.8rem;
  }

  @media (min-width: 768px) {
    .section-title {
      font-size: 3.1rem;
    }
  }

  .gold-text {
    color: var(--color-gold-champagne);
  }

  .section-subtitle {
    font-size: 1.08rem;
    color: #556677;
    line-height: 1.65;
  }

  .faq-accordion-wrap {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background-color: var(--color-bg-ivory);
    border: 1px solid rgba(22, 58, 95, 0.08);
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .faq-item[open] {
    border-color: var(--color-gold-champagne);
    box-shadow: 0 8px 24px -4px rgba(22, 58, 95, 0.06);
  }

  .faq-summary {
    list-style: none;
    padding: 1.5rem 1.8rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-primary-dark);
    user-select: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-cat-badge {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background-color: rgba(22, 58, 95, 0.06);
    color: var(--color-primary-medium);
    padding: 0.25rem 0.55rem;
    border-radius: 4px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .faq-question-text {
    flex: 1;
    font-size: 1.05rem;
    line-height: 1.4;
  }

  .faq-icon {
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--color-gold-champagne);
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-answer-content {
    padding: 0 1.8rem 1.6rem 1.8rem;
  }

  .faq-answer-content p {
    font-size: 0.98rem;
    color: #4B5C6C;
    line-height: 1.7;
    margin: 0;
    border-top: 1px solid rgba(22, 58, 95, 0.06);
    padding-top: 1rem;
  }
</style>
