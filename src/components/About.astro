---
import { siteConfig } from '../data/content';
---

<section id="sobre-mi" class="about-section scroll-reveal-section">
  <div class="container">
    
    <!-- Encabezado de la Sección -->
    <div class="about-header text-center reveal-item">
      <h2 class="about-main-title">
        Angela María Ramírez Bedoya
      </h2>
      <p class="about-lead-subtitle">
        Contadora Pública - Especialización en Revisoría Fiscal y Auditoria Forense
      </p>
      <div class="name-divider-track" aria-hidden="true">
        <div class="name-divider-bar"></div>
      </div>
    </div>

    <!-- Cuadrícula Principal de 2 Columnas -->
    <div class="about-grid-main">
      
      <!-- Columna Izquierda: Tarjeta Editorial Sticky con Foto Real y Títulos de Estudio -->
      <div class="about-sidebar-sticky">
        <div class="about-profile-card reveal-left">
          
          <!-- Foto de Perfil con Halo Dorado -->
          <div class="profile-photo-wrapper">
            <div class="photo-glow-aura" aria-hidden="true"></div>
            <img 
              src={`${import.meta.env.BASE_URL}angela-portrait.png`} 
              alt="Angela María Ramírez Bedoya - Contadora Pública" 
              class="profile-photo-img"
              loading="lazy"
            />
          </div>

          <div class="profile-meta-block">
            <h3 class="profile-card-name">Angela M. Ramírez</h3>
            <p class="profile-card-role">Gestión Contable, Tributaria & Aseguramiento</p>
            
            <div class="profile-credentials-list">
              <div class="credential-item">
                <div class="cred-icon-gold" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B89B5E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                    <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                  </svg>
                </div>
                <span class="cred-title">Esp. en Revisoría Fiscal</span>
              </div>

              <div class="credential-item">
                <div class="cred-icon-gold" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B89B5E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                    <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                  </svg>
                </div>
                <span class="cred-title">Contaduría Pública</span>
              </div>

              <div class="credential-item">
                <div class="cred-icon-gold" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B89B5E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                    <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                  </svg>
                </div>
                <span class="cred-title">Diplomado en Revisoría Fiscal</span>
              </div>

              <div class="credential-item">
                <div class="cred-icon-gold" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B89B5E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                    <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                  </svg>
                </div>
                <span class="cred-title">Diplomado en NIIF</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Resumen Profesional Ejecutivo y Enunciación de Logros -->
      <div class="about-narrative-col reveal-right">
        
        <!-- Bloque de Perfil -->
        <div class="about-bio-box">
          <h3 class="bio-subtitle">Sólida Claridad Conceptual, Rigor Técnico y Solvencia Ética</h3>
          <p class="bio-text">
            Soy <strong>Angela María Ramírez Bedoya</strong>, Contadora Pública con más de una década de ejercicio profesional enfocado en el diseño, implementación y dirección de sistemas de información contable y controles internos que impulsan los objetivos organizacionales.
          </p>
          <p class="bio-text">
            Mi práctica se fundamenta en el apego irrestricto a las <strong>Normas Internacionales de Información Financiera (NIIF)</strong> y <strong>Normas Internacionales de Auditoría (NIA)</strong>, garantizando a juntas directivas, consejos de administración y entes corporativos una administración financiera transparente, oportuna y libre de contingencias ante la DIAN y entidades de control.
          </p>
        </div>

        <!-- Enunciación de Logros Profesionales Comprobados -->
        <div class="achievements-container">
          <h4 class="achievements-heading">
            <span class="gold-bullet">◆</span> Logros Profesionales Destacados
          </h4>

          <div class="achievements-grid">
            
            <!-- Logro 1: Revisoría Fiscal y Auditoría NIAS -->
            <div class="achieve-card">
              <div class="achieve-header">
                <span class="achieve-number">01</span>
                <h5 class="achieve-title">Revisoría Fiscal & Auditoría bajo NIAS</h5>
              </div>
              <p class="achieve-desc">
                En <strong>Servicios Integrales y Consultorías GZ S.A.S.</strong>, participación activa en la planeación y ejecución de auditorías financieras y de revisoría fiscal bajo <strong>Normas Internacionales de Auditoría (NIA)</strong>, asegurando transparencia, rigor técnico y mitigación preventiva de riesgos societarios.
              </p>
            </div>

            <!-- Logro 2: Cumplimiento Fiscal y Fiscalización DIAN -->
            <div class="achieve-card">
              <div class="achieve-header">
                <span class="achieve-number">02</span>
                <h5 class="achieve-title">Cumplimiento Tributario & Cero Sanciones</h5>
              </div>
              <p class="achieve-desc">
                Supervisión contable integral y elaboración de declaraciones fiscales nacionales y municipales (IVA, Renta, Retención en la fuente, Régimen Simple - RST, ReteICA) en compañías como <strong>SINTECOL S.A.S.</strong> e <strong>Inversiones BEPIR S.A.S.</strong>, con acompañamiento exitoso en procesos de fiscalización ante la DIAN.
              </p>
            </div>

            <!-- Logro 3: Transformación Digital e Implementación Electrónica -->
            <div class="achieve-card">
              <div class="achieve-header">
                <span class="achieve-number">03</span>
                <h5 class="achieve-title">Facturación & Nómina Electrónica DIAN</h5>
              </div>
              <p class="achieve-desc">
                Liderazgo en la parametrización, habilitación y puesta en marcha de documentos electrónicos (facturación y nómina electrónica), estableciendo manuales de procedimiento, registro oportuno de operaciones y reportes fidedignos para entidades reguladoras.
              </p>
            </div>

            <!-- Logro 4: Control Interno y Finanzas en Propiedad Horizontal -->
            <div class="achieve-card">
              <div class="achieve-header">
                <span class="achieve-number">04</span>
                <h5 class="achieve-title">Control Presupuestal en Copropiedades (P.H.)</h5>
              </div>
              <p class="achieve-desc">
                En <strong>La Gran Reserva Río P.H.</strong>, implementación de controles internos para la adecuada gestión de ingresos y gastos, coordinación de cartera con recaudo oportuno y sustentación periódica de informes financieros ante el Consejo de Administración y Revisoría Fiscal.
              </p>
            </div>

          </div>
        </div>

      </div>

    </div>

    <!-- Recuadro de Cierre Editorial de Confianza (Ancho Completo de la Hoja) -->
    <div class="about-cta-footer reveal-up">
      <p class="cta-quote">
        &ldquo;Generadora de valor empresarial, rigor probatorio y fe pública ética al servicio de su tranquilidad.&rdquo;
      </p>
    </div>

  </div>
</section>

<style>
  .about-section {
    position: relative;
    z-index: 1;
    padding: clamp(4.5rem, 8vh, 7rem) 0;
    background: transparent;
    overflow-x: clip;
  }

  /* Animación al Scroll Progresiva */
  .scroll-reveal-section {
    opacity: 0;
    transform: translateY(50px) scale(0.985);
    transition: opacity 1.1s cubic-bezier(0.16, 1, 0.3, 1), transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .scroll-reveal-section.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .reveal-left {
    opacity: 0;
    transform: translateX(-35px);
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s, transform 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s;
  }

  .reveal-right {
    opacity: 0;
    transform: translateX(35px);
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.25s, transform 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.25s;
  }

  .reveal-up {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.35s, transform 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.35s;
  }

  .scroll-reveal-section.is-visible .reveal-left,
  .scroll-reveal-section.is-visible .reveal-right,
  .scroll-reveal-section.is-visible .reveal-up {
    opacity: 1;
    transform: translate(0, 0);
  }

  .text-center {
    text-align: center;
  }

  .about-header {
    text-align: center;
    margin-bottom: clamp(2.5rem, 5vh, 4rem);
  }

  .about-main-title {
    display: inline-block;
    text-align: center;
    font-family: var(--font-serif, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(2.2rem, 3.6vw, 3.4rem);
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-top: 0.6rem;
    line-height: 1.15;
    max-width: 100%;
  }

  .about-lead-subtitle {
    text-align: center;
    font-family: var(--font-sans);
    font-size: clamp(0.9rem, 1.1vw, 1.05rem);
    color: #637587;
    margin-top: 0.5rem;
    font-weight: 500;
  }

  /* Línea dorada animada del ancho del nombre */
  .name-divider-track {
    display: block;
    width: min(600px, 90vw);
    max-width: 100%;
    height: 3px;
    margin: 1.25rem auto 0 auto;
    position: relative;
    background: rgba(184, 155, 94, 0.15);
    border-radius: 999px;
    overflow: hidden;
  }

  .name-divider-bar {
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, #9E7D3B 0%, #DFCA8D 45%, #FFF6D6 52%, #DFCA8D 60%, #B89B5E 100%);
    background-size: 200% 100%;
    transform-origin: left center;
    transform: scaleX(0);
    border-radius: 999px;
    box-shadow: 0 0 10px rgba(223, 202, 141, 0.6);
    transition: transform 1.3s cubic-bezier(0.22, 1, 0.36, 1) 0.35s;
  }

  .scroll-reveal-section.is-visible .name-divider-bar {
    transform: scaleX(1);
  }

  /* Cuadrícula Principal */
  .about-grid-main {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  @media (min-width: 992px) {
    .about-grid-main {
      grid-template-columns: 380px 1fr;
    }
  }

  @media (min-width: 1200px) {
    .about-grid-main {
      grid-template-columns: 420px 1fr;
      gap: 4rem;
    }
  }

  /* Columna Izquierda: Contenedor Sticky y Tarjeta de Perfil */
  .about-sticky-sidebar {
    position: relative;
    width: 100%;
  }

  @media (min-width: 992px) {
    .about-sticky-sidebar {
      position: sticky;
      top: 96px;
      align-self: start;
      z-index: 10;
    }
  }

  .about-profile-card {
    background: rgba(255, 255, 255, 0.93);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(22, 58, 95, 0.1);
    border-radius: 16px;
    padding: clamp(1.6rem, 2.4vw, 2.2rem) 1.5rem;
    box-shadow: 0 16px 45px rgba(22, 58, 95, 0.05);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    width: 100%;
  }

  .profile-photo-wrapper {
    position: relative;
    width: clamp(140px, 14vw, 170px);
    height: clamp(140px, 14vw, 170px);
    margin: 0 auto 1.2rem;
  }

  .photo-glow-aura {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(223, 202, 141, 0.6), rgba(184, 155, 94, 0.2));
    filter: blur(8px);
    z-index: 0;
  }

  .profile-photo-img {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    border: 3px solid #B89B5E;
    box-shadow: 0 8px 25px rgba(22, 58, 95, 0.15);
    background: #FAFAF8;
    z-index: 1;
  }

  .profile-meta-block {
    width: 100%;
    margin-top: 0.5rem;
  }

  .profile-card-name {
    font-family: var(--font-serif, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin: 0;
  }

  .profile-card-role {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-gold-champagne);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0.25rem 0 1rem;
  }

  .profile-credentials-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-align: left;
    border-top: 1px solid rgba(22, 58, 95, 0.08);
    padding-top: 1.1rem;
    width: 100%;
  }

  .credential-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.45rem 0.6rem;
    border-radius: 8px;
    background: rgba(22, 58, 95, 0.02);
    border: 1px solid rgba(22, 58, 95, 0.04);
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .credential-item:hover {
    background: rgba(184, 155, 94, 0.08);
    transform: translateX(3px);
  }

  .cred-icon-gold {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(184, 155, 94, 0.12);
    border: 1px solid rgba(184, 155, 94, 0.3);
    color: var(--color-gold-champagne, #B89B5E);
    flex-shrink: 0;
  }

  .cred-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    line-height: 1.3;
  }

  /* Columna Derecha: Narrativa y Logros */
  .about-narrative-col {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .about-bio-box {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(22, 58, 95, 0.08);
    border-radius: 12px;
    padding: clamp(1.5rem, 2.5vw, 2.2rem);
    box-shadow: 0 10px 30px rgba(22, 58, 95, 0.03);
  }

  .bio-subtitle {
    font-family: var(--font-sans);
    font-size: clamp(1.1rem, 1.4vw, 1.35rem);
    font-weight: 800;
    color: var(--color-primary-dark);
    margin: 0 0 1rem;
    letter-spacing: -0.015em;
  }

  .bio-text {
    font-size: 0.95rem;
    color: #4C5D6E;
    line-height: 1.7;
    margin: 0 0 0.85rem;
  }

  .bio-text:last-child {
    margin-bottom: 0;
  }

  /* Logros */
  .achievements-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .achievements-heading {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.25vw, 1.2rem);
    font-weight: 800;
    color: var(--color-primary-dark);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }

  .gold-bullet {
    color: var(--color-gold-champagne);
    font-size: 0.85rem;
  }

  .achievements-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
  }

  @media (min-width: 640px) {
    .achievements-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .achieve-card {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(22, 58, 95, 0.08);
    border-radius: 10px;
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .achieve-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--color-gold-champagne);
    opacity: 0.4;
    transition: opacity 0.3s ease, width 0.3s ease;
  }

  .achieve-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(22, 58, 95, 0.07);
    border-color: rgba(184, 155, 94, 0.35);
  }

  .achieve-card:hover::before {
    opacity: 1;
    width: 5px;
  }

  .achieve-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .achieve-number {
    font-family: 'Plus Jakarta Sans', var(--font-sans), sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-gold-champagne);
    font-variant-numeric: lining-nums tabular-nums;
  }

  .achieve-title {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin: 0;
    line-height: 1.35;
  }

  .achieve-desc {
    font-size: 0.86rem;
    color: #637587;
    line-height: 1.55;
    margin: 0;
  }

  /* Recuadro de Cierre Editorial de Confianza (Ancho Completo de la Hoja) */
  .about-cta-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 100%;
    margin-top: clamp(2.5rem, 5vh, 3.8rem);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(184, 155, 94, 0.3);
    border-radius: 12px;
    padding: clamp(1.4rem, 2.5vw, 1.8rem) clamp(1.8rem, 3.5vw, 3rem);
    box-shadow: 0 10px 30px rgba(22, 58, 95, 0.04);
    text-align: center;
    box-sizing: border-box;
  }

  .cta-quote {
    font-family: var(--font-sans);
    font-size: clamp(0.98rem, 1.2vw, 1.15rem);
    font-weight: 600;
    color: var(--color-primary-dark);
    margin: 0;
    font-style: italic;
    line-height: 1.6;
    text-align: center;
    width: 100%;
    max-width: 980px;
    letter-spacing: -0.01em;
  }
</style>

<script>
  function syncNameDividerWidth() {
    const title = document.querySelector('.about-main-title');
    const track = document.querySelector('.name-divider-track');
    if (!title || !track) return;

    const setWidth = () => {
      const width = title.offsetWidth;
      if (width > 0) {
        track.style.width = width + 'px';
      }
    };

    setWidth();

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(setWidth);
    }

    if (window.ResizeObserver) {
      const ro = new ResizeObserver(() => setWidth());
      ro.observe(title);
    } else {
      window.addEventListener('resize', setWidth);
    }
  }

  function setupAboutScrollReveal() {
    syncNameDividerWidth();

    const section = document.getElementById('sobre-mi');
    if (!section) return;

    // Accesibilidad: respetar reducción de movimiento
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      section.classList.add('is-visible');
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          section.classList.add('is-visible');
          observer.unobserve(section);
        }
      });
    }, {
      threshold: 0.12,
      rootMargin: '0px 0px -40px 0px'
    });

    observer.observe(section);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAboutScrollReveal);
  } else {
    setupAboutScrollReveal();
  }
</script>
