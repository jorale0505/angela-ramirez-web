---
import { serviceAxes, siteConfig } from '../data/content';
---

<section id="servicios" class="services-section scroll-reveal-section services-section-compact">
  <div class="container">
    <!-- Encabezado de Sección Editorial -->
    <div class="section-header text-center reveal-item">
      <h2 class="section-title">
        Servicios Contables y de Aseguramiento
      </h2>
      <div class="services-divider-track" aria-hidden="true">
        <div class="services-divider-bar"></div>
      </div>
    </div>

    <!-- Tarjeta Unificada con Navegación Interna -->
    <div class="services-unified-card fade-up">
      <!-- Pestañas de los 4 Ejes Centrales DENTRO de la Tarjeta -->
      <div class="card-tabs-nav" role="tablist">
        {serviceAxes.map((axis, index) => (
          <button 
            class={`t-btn ${index === 0 ? 'active' : ''}`}
            data-target={axis.id}
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
          >
            {axis.title}
          </button>
        ))}
      </div>

      <!-- Contenedor de Paneles de Servicio -->
      <div class="services-panels-container">
        {serviceAxes.map((axis, index) => (
          <article 
            id={`service-card-${axis.id}`}
            class={`service-panel ${index === 0 ? 'active' : 'hidden'}`}
            data-service={axis.id}
          >
            <!-- Encabezado del Eje -->
            <div class="axis-header">
              <h3 class="axis-title">{axis.title}</h3>
              <p class="axis-tagline">{axis.tagline}</p>
              <p class="axis-summary">{axis.summary}</p>
            </div>

            <!-- Cuadrícula de los 5 Sub-servicios -->
            <div class="subservices-grid">
              {axis.services.map((sub) => (
                <div class="subservice-card">
                  <div class="subservice-top">
                    <svg class="subservice-check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </div>
                  <h4 class="subservice-title">{sub.title}</h4>
                  <p class="subservice-desc">{sub.description}</p>
                </div>
              ))}
            </div>

            <!-- Barra Inferior del Eje: Marco Legal y Botón de Acción -->
            <div class="axis-bottom-bar">
              <div class="axis-legal-box">
                <div class="axis-legal-title">Sustento Legal & Normativa Aplicable</div>
                <div class="axis-legal-text">{axis.legalFramework.join(' · ')}</div>
              </div>
              <div class="axis-cta-wrap">
                <a 
                  href={`https://wa.me/573105274367?text=${encodeURIComponent(axis.whatsappMessage)}`} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="btn btn-primary"
                >
                  {axis.ctaText}
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .services-section {
    padding: 45px 0 35px;
    background-color: var(--color-bg-ivory, #FAF9F5);
    position: relative;
  }

  .text-center {
    text-align: center;
  }

  .section-title {
    font-size: clamp(1.85rem, 3.2vw, 2.5rem);
    color: var(--color-primary-dark, #112B47);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  /* Línea divisoria elegante */
  .services-divider-track {
    width: 100%;
    max-width: 100%;
    height: 2px;
    background: rgba(22, 58, 95, 0.08);
    position: relative;
    margin: 0.6rem auto 1.5rem;
    border-radius: 999px;
    overflow: hidden;
  }

  .services-divider-bar {
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, 
      transparent 0%, 
      #9E7D3B 15%, 
      #DFCA8D 50%, 
      #9E7D3B 85%, 
      transparent 100%
    );
    transform-origin: center center;
    transform: scaleX(0);
    transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .scroll-reveal-section.is-visible .services-divider-bar {
    transform: scaleX(1);
  }

  /* Tarjeta Unificada con Navegación Interna */
  .services-unified-card {
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(22, 58, 95, 0.12);
    border-radius: 16px;
    padding: 1.5rem 1.8rem 1.8rem;
    box-shadow: 0 10px 30px rgba(22, 58, 95, 0.06);
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .services-unified-card {
      padding: 1.1rem 1rem 1.3rem;
      border-radius: 12px;
    }
  }

  /* Barra de Pestañas Dentro de la Tarjeta */
  .card-tabs-nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-bottom: 1rem;
    margin-bottom: 1.15rem;
    border-bottom: 1px solid rgba(22, 58, 95, 0.08);
  }

  /* Botones de Cambio de Eje: Azul corporativo, bordes redondos, activo en dorado */
  .t-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.52rem 1.1rem;
    background: #163A5F;
    border: 1.5px solid rgba(22, 58, 95, 0.4);
    border-radius: 999px;
    font-family: var(--font-sans, 'Montserrat', sans-serif);
    font-size: 0.83rem;
    font-weight: 600;
    color: #FFFFFF;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.25s ease;
    box-shadow: 0 2px 6px rgba(22, 58, 95, 0.12);
  }

  .t-btn:hover {
    background: #1D4B7A;
    border-color: rgba(223, 202, 141, 0.5);
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(22, 58, 95, 0.2);
  }

  .t-btn.active {
    background: #0D263F;
    color: #DFCA8D;
    border: 2px solid #DFCA8D;
    font-weight: 700;
    box-shadow: 0 4px 14px rgba(13, 38, 63, 0.25), 0 0 10px rgba(223, 202, 141, 0.3);
  }

  /* Paneles de Servicio Dentro de la Tarjeta Unificada */
  .service-panel {
    display: none;
    background: transparent;
    border: none;
    padding: 0;
    box-shadow: none;
  }

  .service-panel.active {
    display: block;
    animation: panelFadeIn 0.3s ease;
  }

  .service-panel.hidden {
    display: none;
  }

  @keyframes panelFadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Encabezado del Eje */
  .axis-header {
    margin-bottom: 1.25rem;
    text-align: left;
  }



  .axis-title {
    font-size: 1.65rem;
    color: #163A5F;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-top: 0.35rem;
    margin-bottom: 0.25rem;
    line-height: 1.25;
  }

  .axis-tagline {
    font-weight: 600;
    color: #B89B5E;
    font-size: 0.95rem;
    margin-bottom: 0.45rem;
  }

  .axis-summary {
    font-size: 0.9rem;
    color: #4A5568;
    line-height: 1.55;
    max-width: 950px;
  }

  /* Cuadrícula de Sub-servicios: 5 columnas en desktop */
  .subservices-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
    margin: 1.2rem 0;
  }

  @media (min-width: 560px) {
    .subservices-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 860px) {
    .subservices-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1120px) {
    .subservices-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .subservice-card {
    background: #FFFFFF;
    border: 1px solid rgba(22, 58, 95, 0.1);
    border-radius: 8px;
    padding: 1.1rem 0.95rem;
    box-shadow: 0 2px 8px rgba(22, 58, 95, 0.03);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .subservice-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(22, 58, 95, 0.08);
    border-color: rgba(223, 202, 141, 0.7);
  }

  .subservice-top {
    display: flex;
    align-items: center;
    margin-bottom: 0.55rem;
  }

  .subservice-check-icon {
    width: 17px;
    height: 17px;
    color: #25D366;
    flex-shrink: 0;
  }

  .subservice-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: #163A5F;
    margin-bottom: 0.35rem;
    line-height: 1.3;
  }

  .subservice-desc {
    font-size: 0.8rem;
    color: #5A6A7E;
    line-height: 1.45;
    flex-grow: 1;
  }

  /* Barra Inferior del Eje */
  .axis-bottom-bar {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
    align-items: center;
    margin-top: 1.2rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgba(22, 58, 95, 0.08);
  }

  @media (min-width: 860px) {
    .axis-bottom-bar {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .axis-legal-box {
    background: rgba(22, 58, 95, 0.03);
    border-left: 3px solid #B89B5E;
    padding: 0.75rem 1rem;
    border-radius: 0 6px 6px 0;
  }

  .axis-legal-title {
    font-size: 0.74rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #163A5F;
    margin-bottom: 0.2rem;
  }

  .axis-legal-text {
    font-size: 0.8rem;
    color: #5A6A7E;
    line-height: 1.4;
  }

  .axis-cta-wrap {
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 859px) {
    .axis-cta-wrap {
      justify-content: stretch;
    }
    .axis-cta-wrap .btn {
      width: 100%;
      justify-content: center;
    }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.4rem;
    font-family: var(--font-sans, 'Montserrat', sans-serif);
    font-size: 0.88rem;
    font-weight: 700;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .btn-primary {
    background: linear-gradient(135deg, #163A5F 0%, #0D263F 100%);
    color: #FFFFFF;
    border: 1px solid rgba(223, 202, 141, 0.4);
    box-shadow: 0 4px 14px rgba(22, 58, 95, 0.2);
  }

  .btn-primary:hover {
    background: linear-gradient(135deg, #1D4B7A 0%, #163A5F 100%);
    border-color: #DFCA8D;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(22, 58, 95, 0.3);
  }
</style>

<script>
  function setupServiceTabs() {
    const tabBtns = document.querySelectorAll('.t-btn');
    const servicePanels = document.querySelectorAll('.service-panel');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');

        // Actualizar estado de los botones
        tabBtns.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        // Mostrar el panel correspondiente
        servicePanels.forEach(panel => {
          if (panel.getAttribute('data-service') === targetId) {
            panel.classList.remove('hidden');
            panel.classList.add('active');
          } else {
            panel.classList.add('hidden');
            panel.classList.remove('active');
          }
        });
      });
    });
  }

  function setupServicesScrollReveal() {
    const section = document.getElementById('servicios');
    if (!section) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      section.classList.add('is-visible');
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          section.classList.add('is-visible');
          observer.unobserve(section);
        }
      });
    }, {
      threshold: 0.12,
      rootMargin: '0px 0px -40px 0px'
    });

    observer.observe(section);
  }

  function initServices() {
    setupServiceTabs();
    setupServicesScrollReveal();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initServices);
  } else {
    initServices();
  }
</script>
